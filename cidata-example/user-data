#cloud-config
hostname: ci01
user: debian
ssh_pwauth: false
ssh_authorized_keys:
  - ssh-ed25519 AAAA... replace-with-your-public-key

write_files:
  - content: |
      [Swap]
      What=/swapfile

      [Install]
      WantedBy=swap.target
    path: /etc/systemd/system/swapfile.swap

runcmd:
  - [ sh, -c, "[ ! -e /swapfile ] && { fallocate -l 1G /swapfile && chmod 0600 /swapfile && mkswap /swapfile; }; systemctl daemon-reload && systemctl enable --now swapfile.swap" ]
